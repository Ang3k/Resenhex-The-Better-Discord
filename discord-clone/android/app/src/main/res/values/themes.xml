<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fundo escuro do Resenhex desde a abertura, para não piscar branco antes do site carregar. -->
    <style name="Theme.Resenhex" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:alertDialogTheme">@style/Theme.Resenhex.Dialog</item>
    </style>

    <!-- Diálogos nativos (bateria, atualização) no visual do app: escuros, arredondados e sem botões em maiúsculas. -->
    <style name="Theme.Resenhex.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">@color/brand_light</item>
        <item name="android:textColorPrimary">@color/dialog_text</item>
        <item name="android:textColorSecondary">@color/dialog_text_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/dialog_text</item>
        <item name="android:buttonBarButtonStyle">@style/Resenhex.DialogButton</item>
    </style>
    <style name="Resenhex.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
