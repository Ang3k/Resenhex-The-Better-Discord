{
  "name": "resenhex",
  "version": "1.6.0",
  "description": "Resenhex: chat de texto, voz, câmera e compartilhamento de tela para você e seus amigos (inspirado no Discord)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:voice-chosen": "node --test test/voice-chosen.test.js",
    "check:voice-chosen": "node --check public/voice-fx-chosen.mjs && node --check public/voice-fx-classic-core.mjs && node --check public/voice-fx-classic-worklet.mjs",
    "test:media-browser": "node tools/media-smoke.js",
    "check": "node tools/check-syntax.js"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "express": "^5.2.1",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1",
    "nodemailer": "10.0.13",
    "pngjs": "7.0.0",
    "signalsmith-stretch": "1.3.2",
    "socket.io": "^4.8.4",
    "three": "0.185.1"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "devDependencies": {
    "jsdom": "^26.1.0",
    "socket.io-client": "^4.8.4"
  }
}
