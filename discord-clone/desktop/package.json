{
  "name": "resenhex",
  "productName": "Resenhex",
  "version": "1.1.2",
  "description": "Resenhex para Windows",
  "author": "Resenhex",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prestart": "node tools/patch-uiohook.js --build",
    "postinstall": "node tools/patch-uiohook.js",
    "icons": "electron tools/render-icons.js && electron tools/render-windows-icon.js",
    "icons:win": "electron tools/render-windows-icon.js",
    "voice:runtime": "node tools/build-voice-runtime.js",
    "voice:models": "node tools/build-character-voices.js",
    "voice:indexes": "python tools/build-voice-indexes.py",
    "predist": "node tools/patch-uiohook.js --build && npm run voice:runtime && npm run voice:models",
    "dist": "electron-builder --win --publish never",
    "predist:store": "node tools/patch-uiohook.js --build && npm run voice:runtime && npm run voice:models",
    "dist:store": "electron-builder --win appx --x64 --publish never -c.toolsets.winCodeSign=1.1.0",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.resenhex.desktop",
    "productName": "Resenhex",
    "copyright": "Resenhex",
    "artifactName": "Resenhex-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "overlay-preload.js",
      "main.js",
      "preload.js",
      "titlebar-preload.js",
      "titlebar.html",
      "titlebar.js",
      "offline.html",
      "offline.js",
      "lib/**",
      "assets/**",
      "!**/node_modules/**/*.{map,d.ts}",
      "!**/node_modules/js-yaml/{bin,dist}{,/**}",
      "!**/node_modules/argparse{,/**}",
      "!**/node_modules/uiohook-napi/{src,libuiohook,binding.gyp}{,/**}",
      "!**/node_modules/uiohook-napi/prebuilds/!(win32-x64){,/**}",
      "!**/node_modules/uiohook-napi/build/{*.*,Release/obj,Release/*.{lib,iobj,ipdb,pdb,exp}}{,/**}",
      "!**/node_modules/koffi/{src,doc,vendor}{,/**}",
      "!**/node_modules/koffi/build/koffi/!(win32_x64){,/**}",
      "!**/node_modules/koffi/build/koffi/win32_x64/*.{lib,exp}"
    ],
    "electronLanguages": [
      "pt-BR",
      "pt-PT",
      "en-US",
      "en-GB",
      "es",
      "es-419"
    ],
    "extraResources": [
      { "from": "build/icon.ico", "to": "icon.ico" },
      { "from": "voice-engine", "to": "voice-engine", "filter": ["engine.py", "windows-runtime.lock.json", "THIRD-PARTY-NOTICES.md", "licenses/**", "runtime/**"] }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Resenhex",
      "uninstallDisplayName": "Resenhex",
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "identityName": "AngelD.Mansilla.Resenhex",
      "publisher": "CN=4BC4D576-D0B2-432B-9D0E-7075FE88F1BE",
      "publisherDisplayName": "Angel D. Mansilla",
      "applicationId": "Resenhex",
      "displayName": "Resenhex",
      "backgroundColor": "transparent",
      "languages": [
        "pt-BR"
      ],
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "microphone",
        "webcam"
      ],
      "minVersion": "10.0.19041.0",
      "maxVersionTested": "10.0.26100.0",
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "Resenhex-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://resenhex.duckdns.org/download/"
      }
    ]
  }
}
