{
  "name": "resenhex",
  "productName": "Resenhex",
  "version": "1.0.0",
  "description": "Resenhex para Windows",
  "author": "Resenhex",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "electron tools/render-icons.js",
    "dist": "electron-builder --win --publish never",
    "dist:store": "electron-builder --win appx --x64 --publish never -c.toolsets.winCodeSign=1.1.0",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.resenhex.desktop",
    "productName": "Resenhex",
    "copyright": "Resenhex",
    "artifactName": "Resenhex-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "titlebar-preload.js",
      "titlebar.html",
      "titlebar.js",
      "offline.html",
      "offline.js",
      "lib/**",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Resenhex",
      "uninstallDisplayName": "Resenhex",
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "identityName": "AngelD.Mansilla.Resenhex",
      "publisher": "CN=4BC4D576-D0B2-432B-9D0E-7075FE88F1BE",
      "publisherDisplayName": "Angel D. Mansilla",
      "applicationId": "Resenhex",
      "displayName": "Resenhex",
      "backgroundColor": "transparent",
      "languages": [
        "pt-BR"
      ],
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "microphone",
        "webcam"
      ],
      "minVersion": "10.0.19041.0",
      "maxVersionTested": "10.0.26100.0",
      "customExtensionsPath": "build/appx-extensions.xml",
      "artifactName": "Resenhex-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://resenhex.duckdns.org/download/"
      }
    ]
  }
}
